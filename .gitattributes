# Normalize text files to LF in the repository and working copy.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.glb binary
*.gltf binary
*.fbx binary
*.blend binary
*.mp3 binary
*.wav binary
*.mp4 binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.db binary
